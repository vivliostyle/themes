{
  "name": "themes",
  "version": "0.0.0",
  "private": true,
  "description": "Central source of official themes.",
  "license": "Apache-2.0",
  "repository": "git@github.com:vivliostyle/themes.git",
  "type": "module",
  "scripts": {
    "build": "pnpm run --sequential \"/^build:.*/\"",
    "build:tools": "pnpm --filter './packages/*' run build",
    "build:themes": "pnpm --filter './packages/@vivliostyle/*' run build",
    "bump": "pnpm run top && pnpm exec changeset version",
    "capture-pdf": "node scripts/capture-pdf.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "pnpm -r run test",
    "top": "node scripts/top.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm --filter './packages/@vivliostyle/*' run validate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@napi-rs/canvas": "^0.1.56",
    "@types/node": "^24.0.0",
    "@vivliostyle/cli": "11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pdfjs-dist": "4.6.82",
    "pnpm": "11.17.0",
    "typescript": "^5.3.3",
    "vivliostyle-theme-scripts": "workspace:*"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
