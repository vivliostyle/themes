{
  "name": "themes",
  "description": "Central source of official themes.",
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run --sequential \"/^build:.*/\"",
    "build:tools": "pnpm --filter './packages/*' run build",
    "build:themes": "pnpm --filter './packages/@vivliostyle/*' run build",
    "bump": "pnpm run top && pnpm exec changeset version",
    "capture-pdf": "node scripts/capture-pdf.mts",
    "lint": "pnpm run --parallel \"/^lint:.*/\"",
    "lint:theme": "pnpm --filter './packages/@vivliostyle/*' run validate",
    "test": "pnpm -r run test",
    "top": "node scripts/top.mts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@napi-rs/canvas": "^0.1.56",
    "@types/node": "^24.0.0",
    "@vivliostyle/cli": "11.1.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "pdfjs-dist": "4.6.82",
    "pnpm": "11.17.0",
    "prettier": "^3.3.3",
    "pretty-quick": "^4.0.0",
    "typescript": "^5.3.3",
    "vivliostyle-theme-scripts": "workspace:*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && pretty-quick --staged"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "repository": "git@github.com:vivliostyle/themes.git",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "private": true
}
