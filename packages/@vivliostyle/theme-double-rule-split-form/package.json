{
  "name": "@vivliostyle/theme-double-rule-split-form",
  "version": "0.0.0",
  "description": "A4 theme in black for combined business forms, with a receipt in the upper half and a delivery note in the lower half, split by a thick double rule",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-double-rule-split-form"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Double Rule Split Form",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "forms",
        "combined",
        "delivery",
        "a4",
        "dual-section",
        "commercial",
        "sans-serif"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦・墨1色の複合帳票テーマ。上半分に領収書、下半分に納品書を収め、中央の太い二重罫で分割する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Double Rule Split Form sample",
        "source": "./templates/default"
      }
    }
  }
}
