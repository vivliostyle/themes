{
  "name": "@vivliostyle/theme-landscape-grid-drawing",
  "version": "0.0.0",
  "description": "B4横判・技術図面レイアウトの建築展図録テーマ。5mm方眼上に図面を配置し、下段に解説と仕様表を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-landscape-grid-drawing"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Landscape Grid Drawing",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "exhibition-museum",
        "architecture",
        "technical-drawing",
        "b4",
        "blueprint",
        "minimalist",
        "exhibition-catalog"
      ]
    },
    "template": {
      "default": {
        "name": "Landscape Grid Drawing sample",
        "source": "./templates/default"
      }
    }
  }
}
