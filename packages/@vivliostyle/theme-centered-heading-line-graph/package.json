    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Centered Heading Line Graph",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "textbook-higher",
        "economics",
        "data-driven",
        "graph-heavy",
        "two-column",
        "serif",
        "a4",
        "charts"
      ]
