{
  "name": "@vivliostyle/theme-red-step-badge-caution-box",
  "version": "0.0.0",
  "description": "A5判横組み2段の高校化学実験マニュアルテーマ。赤を限定使用したSTEPバッジと安全上の注意ボックスが特徴",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-red-step-badge-caution-box"
  },
