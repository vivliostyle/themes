{
  "name": "@vivliostyle/theme-three-column-index-tab-figure",
  "version": "0.0.0",
  "description": "Three-column A4 theme for illustrated botanical glossaries, with native and introduced markers, schematic leaf figures and Japanese syllabary index tabs",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-three-column-index-tab-figure"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Three Column Index Tab Figure",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "reference",
        "botanical-glossary",
        "tall-vertical",
        "three-column",
        "illustrated",
        "serif"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦・三段組の植物ビジュアル用語集テーマ。在来/外来のマーカーと模式葉形図版、五十音索引タブで見出し語を組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Three Column Index Tab Figure sample",
        "source": "./templates/default"
      }
    }
  }
}
