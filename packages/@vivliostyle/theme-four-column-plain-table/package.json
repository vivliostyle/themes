{
  "name": "@vivliostyle/theme-four-column-plain-table",
  "version": "0.0.0",
  "description": "Four-column theme for dense catalogs, packing plain three-column tables continuously across the columns",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-four-column-plain-table"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Four Column Plain Table",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "reference",
        "catalog",
        "technical",
        "four-column",
        "monospace",
        "dense",
        "specifications",
        "database-like"
      ],
      "i18n": {
        "ja": {
          "description": "4段組のデータベース風カタログテーマ。3列のプレーン表を段をまたいで高密度に連続配置"
        }
      }
    },
    "template": {
      "default": {
        "name": "Four Column Plain Table sample",
        "source": "./templates/default"
      }
    }
  }
}
