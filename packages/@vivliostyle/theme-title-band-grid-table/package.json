{
  "name": "@vivliostyle/theme-title-band-grid-table",
  "version": "0.0.0",
  "description": "Theme for billing statements, with a solid title band and three-column grid tables",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-title-band-grid-table"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Title Band Grid Table",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "business",
        "three-column",
        "sans-serif",
        "transaction",
        "a4",
        "detailed"
      ],
      "i18n": {
        "ja": {
          "description": "実務帳票の利用明細書テーマ。ベタ帯タイトルと3段組の格子表で構成する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Title Band Grid Table sample",
        "source": "./templates/default"
      }
    }
  }
}
