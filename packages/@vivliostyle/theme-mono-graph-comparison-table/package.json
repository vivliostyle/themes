{
  "name": "@vivliostyle/theme-mono-graph-comparison-table",
  "version": "0.0.0",
  "description": "Two-column A4 theme in black for audio equipment review magazines, putting frequency response graphs and specification tables first",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-mono-graph-comparison-table"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Mono Graph Comparison Table",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "magazine",
      "topics": [
        "magazine",
        "audio",
        "equipment",
        "a4",
        "two-column",
        "monochrome",
        "technical",
        "data-grid"
      ],
      "i18n": {
        "ja": {
          "description": "A4判モノクロ2段組のオーディオ機器レビュー誌テーマ。周波数特性グラフと仕様比較表でデータ視認性を優先した紙面"
        }
      }
    },
    "template": {
      "default": {
        "name": "Mono Graph Comparison Table sample",
        "source": "./templates/default"
      }
    }
  }
}
