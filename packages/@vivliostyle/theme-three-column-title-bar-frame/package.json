{
  "name": "@vivliostyle/theme-three-column-title-bar-frame",
  "version": "0.0.0",
  "description": "Very dense three-column theme for collections of conference abstracts, with reversed title bars, frame rules all around and closing acknowledgment and notice boxes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-three-column-title-bar-frame"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Three Column Title Bar Frame",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "academic",
        "a4",
        "three-column",
        "dense",
        "colorful",
        "keyword-highlight"
      ],
      "i18n": {
        "ja": {
          "description": "3段組の超高密度な学会講演要旨集テーマ。白抜きタイトルバーと全周枠罫、末尾の謝辞・注意事項ボックスを組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Three Column Title Bar Frame sample",
        "source": "./templates/default"
      }
    }
  }
}
