{
  "name": "@vivliostyle/theme-hanging-heading-dropcap-marginalia",
  "version": "0.0.0",
  "description": "Book-style report theme with hanging headings, three-line drop caps and ruled marginal notes on an asymmetric grid",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-hanging-heading-dropcap-marginalia"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Hanging Heading Dropcap Marginalia",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "report",
        "book-style",
        "shiroku",
        "mincho",
        "serif",
        "elegant",
        "vertical-margin"
      ],
      "i18n": {
        "ja": {
          "description": "単行本風のレポートテーマ。ハンギング見出しと3行取りドロップキャップ、罫付きの傍注を非対称グリッドに配する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Hanging Heading Dropcap Marginalia sample",
        "source": "./templates/default"
      }
    }
  }
}
