{
  "name": "@vivliostyle/theme-two-column-verse-number",
  "version": "0.0.0",
  "description": "A4・2段組の聖典本文テーマ。節番号の太字ノンブルと脚注機構、天部の連結罫の柱で静謐な組版を作る",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-two-column-verse-number"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Two Column Verse Number",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "religion-philosophy",
        "bible",
        "two-column",
        "religious-text",
        "a4",
        "verse-numbered",
        "footnotes",
        "elegant",
        "serif"
      ]
    },
    "template": {
      "default": {
        "name": "Two Column Verse Number sample",
        "source": "./templates/default"
      }
    }
  }
}
