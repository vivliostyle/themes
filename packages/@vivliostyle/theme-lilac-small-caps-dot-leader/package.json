{
  "name": "@vivliostyle/theme-lilac-small-caps-dot-leader",
  "version": "0.0.0",
  "description": "A5判・1段組のパティスリーメニューテーマ。ライラックの細罫と欧文スモールキャップ、点線リーダーの品目表で華やかな菓子店の世界観を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-lilac-small-caps-dot-leader"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
