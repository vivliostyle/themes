{
  "name": "@vivliostyle/theme-two-column-three-line-table",
  "version": "0.0.0",
  "description": "B5判・英語2段組の国際学術論文集テーマ。番号付き見出し、MathMLディスプレイ数式、三線データ表、段下脚注を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-two-column-three-line-table"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Two Column Three Line Table",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "essay-critique",
        "academic",
        "research",
        "b5",
        "two-column",
        "formal"
      ]
    },
    "template": {
      "default": {
        "name": "Two Column Three Line Table sample",
        "source": "./templates/default"
      }
    }
  }
}
