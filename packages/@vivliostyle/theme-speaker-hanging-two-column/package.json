{
  "name": "@vivliostyle/theme-speaker-hanging-two-column",
  "version": "0.0.0",
  "description": "Two-column theme for podcast transcripts turned into books, with dialogue set under hanging speaker names and an accent color",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-speaker-hanging-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Speaker Hanging Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "web-book",
        "podcast",
        "two-column",
        "letter",
        "conversational",
        "dialogue",
        "accessible"
      ],
      "i18n": {
        "ja": {
          "description": "ポッドキャスト書き起こしの書籍化向け2段組テーマ。話者名ぶら下げの対話組みとアクセントカラーで構成"
        }
      }
    },
    "template": {
      "default": {
        "name": "Speaker Hanging Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
