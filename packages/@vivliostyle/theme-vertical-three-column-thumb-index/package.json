{
  "name": "@vivliostyle/theme-vertical-three-column-thumb-index",
  "version": "0.0.0",
  "description": "A5判・縦組み3段の古語辞典テーマ。柱に見出し語範囲、小口にツメ見出し、地にノンブルを配した高密度な辞典紙面",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-three-column-thumb-index"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Three Column Thumb Index",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "dictionary-reference",
        "classical-language",
        "a5",
        "vertical-writing",
        "ultra-dense",
        "mincho"
      ]
    },
    "template": {
      "default": {
        "name": "Vertical Three Column Thumb Index sample",
        "source": "./templates/default"
      }
    }
  }
}
