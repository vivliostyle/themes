{
  "name": "@vivliostyle/theme-mono-green-entry-form",
  "version": "0.0.0",
  "description": "Fishing log form theme for a slim 105 × 173 mm planner, fitting monospaced entry fields, catch tables and ruled notes in one green on a spread",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-mono-green-entry-form"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Mono Green Entry Form",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "forms",
        "fishing",
        "sport",
        "dense",
        "data-recording",
        "monospace",
        "table-format",
        "specialist"
      ],
      "i18n": {
        "ja": {
          "description": "スリム手帳判 (105×173mm) の釣果記録フォームテーマ。等幅組み・緑1色で記入欄・釣果テーブル・NOTES 罫を1見開きに収める"
        }
      }
    },
    "template": {
      "default": {
        "name": "Mono Green Entry Form sample",
        "source": "./templates/default"
      }
    }
  }
}
