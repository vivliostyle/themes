{
  "name": "@vivliostyle/theme-three-column-card-table-syntax",
  "version": "0.0.0",
  "description": "Three-column theme for rulebooks of card-based tabletop RPGs, combining card effect tables and code-like syntax blocks in one chapter",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-three-column-card-table-syntax"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Three Column Card Table Syntax",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "trpg-game",
        "card-game",
        "rules",
        "grid",
        "reference",
        "b5",
        "monospace",
        "dense"
      ],
      "i18n": {
        "ja": {
          "description": "TRPGカードゲームのルールブック向け3段組テーマ。カード効果対照表とコード風の構文ブロックを1章にまとめる"
        }
      }
    },
    "template": {
      "default": {
        "name": "Three Column Card Table Syntax sample",
        "source": "./templates/default"
      }
    }
  }
}
