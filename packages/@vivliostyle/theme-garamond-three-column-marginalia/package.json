{
  "name": "@vivliostyle/theme-garamond-three-column-marginalia",
  "version": "0.0.0",
  "description": "Three-column A4 theme for a university press's 150th anniversary history, with EB Garamond text, numbered section headings, outer marginal notes and footnotes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-garamond-three-column-marginalia"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Garamond Three Column Marginalia",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "yearbook-anthology",
        "academic",
        "a4",
        "three-column",
        "dense",
        "footnotes",
        "indexed"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦・3段組の大学出版局150周年記念誌 (学史) テーマ。EB Garamond 本文と番号付き節見出し、小口側の傍注、脚注を密に組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Garamond Three Column Marginalia sample",
        "source": "./templates/default"
      }
    }
  }
}
