  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-spanning-title-boxed"
  },
  "files": [
    "*.css",
    "example",
    "vivliostyle.config.js"
  ],
