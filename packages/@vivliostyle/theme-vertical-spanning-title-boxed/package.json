{
  "name": "@vivliostyle/theme-vertical-spanning-title-boxed",
  "version": "0.0.0",
  "description": "Vertical A4 theme in black for feature pages of general-interest magazines, with large titles across the columns, vertical rules, marginal note columns and boxed articles in a postwar review style",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-spanning-title-boxed"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Spanning Title Boxed",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "magazine",
      "topics": [
        "magazine",
        "monthly",
        "vertical-writing",
        "literature",
        "intellectual",
        "elegant",
        "traditional",
        "japanese"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦組み・墨一色の総合誌特集ページテーマ。段抜きの大題と縦罫、傍注列、囲み記事を組む戦後論壇誌風の紙面"
        }
      }
    },
    "template": {
      "default": {
        "name": "Vertical Spanning Title Boxed sample",
        "source": "./templates/default"
      }
    }
  }
}
