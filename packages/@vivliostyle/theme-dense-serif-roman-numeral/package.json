{
  "name": "@vivliostyle/theme-dense-serif-roman-numeral",
  "version": "0.0.0",
  "description": "Theme for physics letter journals in the style of PRL, setting dense two-column STIX Two Text with Roman-numeral section headings and numbered display equations on letter paper",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-dense-serif-roman-numeral"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Dense Serif Roman Numeral",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "academic",
        "two-column",
        "letter",
        "physics",
        "dense"
      ],
      "i18n": {
        "ja": {
          "description": "PRL 風物理学レター誌テーマ。STIX Two Text の高密度セリフ2段組に、ローマ数字の節見出しと式番号付きディスプレイ数式でレター判の論文を組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Dense Serif Roman Numeral sample",
        "source": "./templates/default"
      }
    }
  }
}
