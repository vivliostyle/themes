{
  "name": "@vivliostyle/theme-mono-hairline-two-column",
  "version": "0.0.0",
  "description": "レター判2段組・IBM Plex Mono等幅体の高密度RF-ICデータシートテーマ。極細グレー罫とタブラー数字で工業文書らしい情報密度を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-mono-hairline-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Mono Hairline Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "datasheet",
        "semiconductor",
        "letter",
        "two-column",
        "dense",
        "rf-ic",
        "technical",
        "monospace"
      ]
    },
    "template": {
      "default": {
        "name": "Mono Hairline Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
