{
  "name": "@vivliostyle/theme-latex-two-column-theorem",
  "version": "0.0.0",
  "description": "A4判2段組・墨1色の LaTeX 風学術論文誌テーマ。罫線ボックスの定理環境、booktabs 風の統計表、式番号付き数式を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-latex-two-column-theorem"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Latex Two Column Theorem",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "academic-journal",
        "academic",
        "a4",
        "two-column",
        "statistics",
        "mathematical",
        "plain-heading",
        "theorem-boxed"
      ]
    },
    "template": {
      "default": {
        "name": "Latex Two Column Theorem sample",
        "source": "./templates/default"
      }
    }
  }
}
