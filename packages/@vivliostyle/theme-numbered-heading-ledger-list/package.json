{
  "name": "@vivliostyle/theme-numbered-heading-ledger-list",
  "version": "0.0.0",
  "description": "Two-column horizontal theme for member directories, repeating four-column ledger grids under numbered headings",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-numbered-heading-ledger-list"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Numbered Heading Ledger List",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "reference",
        "membership-list",
        "directory",
        "two-column",
        "numbered-entries",
        "ledger",
        "formal-structure",
        "b5"
      ],
      "i18n": {
        "ja": {
          "description": "横書き2段組の名簿テーマ。柱+ヘッダー罫、番号付き見出し、4列台帳型グリッドを高密度に反復"
        }
      }
    },
    "template": {
      "default": {
        "name": "Numbered Heading Ledger List sample",
        "source": "./templates/default"
      }
    }
  }
}
