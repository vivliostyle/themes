{
  "name": "@vivliostyle/theme-epub3j",
  "version": "2.0.0",
  "description": "Theme for Japanese EPUB 3 publications, following the EBPAJ EPUB 3 File Creation Guide",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-epub3j"
  },
  "files": [
    "*.css",
    "ebpaj_epub3guide",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "EPUB3 (Japanese)",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "novel",
      "topics": [
        "literature",
        "vertical-writing",
        "epub"
      ],
      "i18n": {
        "ja": {
          "description": "日本語EPUB用テーマ（電書協EPUB3制作ガイド準拠）"
        }
      }
    },
    "template": {
      "default": {
        "name": "EPUB3 (Japanese) sample",
        "source": "./templates/default"
      }
    }
  }
}
