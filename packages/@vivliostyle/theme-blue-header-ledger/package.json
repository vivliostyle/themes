{
  "name": "@vivliostyle/theme-blue-header-ledger",
  "version": "0.0.0",
  "description": "A5判・単段の銀行口座取引明細書テーマ。青ベタ白抜きヘッダーの台帳とタブラー数字で桁を揃える",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-blue-header-ledger"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Blue Header Ledger",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "finance-personal",
        "finance",
        "banking",
        "transaction",
        "compact",
        "gothic",
        "one-column",
        "a5",
        "dense"
      ]
    },
    "template": {
      "default": {
        "name": "Blue Header Ledger sample",
        "source": "./templates/default"
      }
    }
  }
}
