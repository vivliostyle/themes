{
  "name": "@vivliostyle/theme-slate-blue-two-column",
  "version": "0.0.0",
  "description": "Two-column A4 theme for corporate technical reports, with numbered Archivo headings, a dark slate blue accent, running heads and folios",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-slate-blue-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Slate Blue Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "academic",
        "corporate-research",
        "a4",
        "two-column",
        "cover",
        "formal",
        "toc",
        "report"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦2段組の企業テクニカルレポート向けテーマ。Archivo の番号付き見出しとダークスレートブルーのアクセント、柱・ノンブル付きの本文ページを組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Slate Blue Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
