{
  "name": "@vivliostyle/theme-spanning-title-two-column-mono",
  "version": "0.0.0",
  "description": "Two-column A4 theme in black for Japanese academic journals, with a title block across the columns, figures, tables, pseudocode and footnotes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-spanning-title-two-column-mono"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Spanning Title Two Column Mono",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "magazine",
        "academic",
        "two-column",
        "technical",
        "data-heavy"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦2段組の和文学術論文誌テーマ。段抜きの題字ブロックと図表・擬似コード、脚注を組む墨一色の誌面"
        }
      }
    },
    "template": {
      "default": {
        "name": "Spanning Title Two Column Mono sample",
        "source": "./templates/default"
      }
    }
  }
}
