{
  "name": "@vivliostyle/theme-issue-number-heading-rule",
  "version": "0.0.0",
  "description": "Single-column horizontal Shinsho theme for collected email newsletters, with issue-number headings, numbered subheadings and ruled running heads",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-issue-number-heading-rule"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Issue Number Heading Rule",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "magazine",
      "topics": [
        "web-book",
        "magazine",
        "pocket-size",
        "single-column",
        "archival",
        "organized"
      ],
      "i18n": {
        "ja": {
          "description": "メールマガジンの合本向け新書判テーマ。号数見出しと連番付き小見出し、柱罫を組む横組み1段の紙面"
        }
      }
    },
    "template": {
      "default": {
        "name": "Issue Number Heading Rule sample",
        "source": "./templates/default"
      }
    }
  }
}
