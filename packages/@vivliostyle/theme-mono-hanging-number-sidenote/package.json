  "vivliostyle": {
    "theme": {
      "name": "Mono Hanging Number Sidenote",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "textbook-higher",
        "programming",
        "computer-science",
        "code-heavy",
