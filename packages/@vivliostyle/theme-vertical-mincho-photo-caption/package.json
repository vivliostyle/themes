{
  "name": "@vivliostyle/theme-vertical-mincho-photo-caption",
  "version": "0.0.0",
  "description": "四六判・縦組み1段の自分史テーマ。明朝の縦組み本文に右肩の章題、小口下の写真とキャプション、地の脚注を静かに組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-mincho-photo-caption"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Mincho Photo Caption",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "novel",
      "topics": [
        "yearbook-anthology",
        "personal-history",
        "custom-size",
        "vertical-writing",
        "elegant",
        "memoir",
        "footnotes"
      ]
    },
    "template": {
      "default": {
        "name": "Vertical Mincho Photo Caption sample",
        "source": "./templates/default"
      }
    }
  }
}
