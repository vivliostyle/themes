{
  "name": "@vivliostyle/theme-two-column-blue-sidenote",
  "version": "0.0.0",
  "description": "A4縦2段組の学会拡張アブストラクト向けテーマ。Inter の番号見出しと青のアクセント、サイドノート、段抜きの図表・疑似コードに対応",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-two-column-blue-sidenote"
  },
  "files": [
    "*.css",
    "example",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
