{
  "name": "@vivliostyle/theme-green-circled-number-two-column",
  "version": "0.0.0",
  "description": "Compact two-column A5 theme for bento cookbooks, repeating fresh green in circled-number headings, data bars and table rules, with one recipe per column",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-green-circled-number-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Green Circled Number Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "practical",
        "a5",
        "two-column",
        "bento",
        "dense",
        "daily-use",
        "time-emphasis",
        "reference"
      ],
      "i18n": {
        "ja": {
          "description": "A5縦2段組のコンパクトなお弁当レシピ本テーマ。フレッシュグリーンを丸数字見出し・データバー・表罫に反復し、左右の段に1品ずつ完結配置する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Green Circled Number Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
