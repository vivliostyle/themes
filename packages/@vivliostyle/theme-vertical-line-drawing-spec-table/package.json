{
  "name": "@vivliostyle/theme-vertical-line-drawing-spec-table",
  "version": "0.0.0",
  "description": "Vertical Shinsho theme in black for pocket bird field guides, packing line drawings and identification tables over observation notes and numbered sections on each page",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-line-drawing-spec-table"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Line Drawing Spec Table",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "reference",
        "birds",
        "pocket-size",
        "single-column",
        "monochrome",
        "practical"
      ],
      "i18n": {
        "ja": {
          "description": "新書判・縦組・墨一色のポケット野鳥図鑑テーマ。線画+識別スペック表の上半分と、観察メモ傍注+番号付き節の下半分を1ページに密に組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Vertical Line Drawing Spec Table sample",
        "source": "./templates/default"
      }
    }
  }
}
