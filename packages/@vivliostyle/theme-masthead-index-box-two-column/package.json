{
  "name": "@vivliostyle/theme-masthead-index-box-two-column",
  "version": "0.0.0",
  "description": "B5判2段組の英文学術ニュース誌テーマ。全幅マストヘッドと索引ボックス、脚注で組む知的な誌面",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-masthead-index-box-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
