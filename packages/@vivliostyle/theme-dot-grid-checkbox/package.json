{
  "name": "@vivliostyle/theme-dot-grid-checkbox",
  "version": "0.0.0",
  "description": "A5 theme for bullet journal daily pages on a 5 mm dot grid, aligning square checkbox task lists and circled notes without rules",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-dot-grid-checkbox"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Dot Grid Checkbox",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "forms",
        "a5",
        "bullet-journal",
        "dot-grid",
        "flexible-layout",
        "minimal",
        "personal",
        "modular"
      ],
      "i18n": {
        "ja": {
          "description": "5mm ドット方眼を敷いた A5 のバレットジャーナル向けデイリーページテーマ。角チェックボックスのタスクリストと丸印メモを罫線なしで整列させる"
        }
      }
    },
    "template": {
      "default": {
        "name": "Dot Grid Checkbox sample",
        "source": "./templates/default"
      }
    }
  }
}
