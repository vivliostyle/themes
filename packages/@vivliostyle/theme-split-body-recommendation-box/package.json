{
  "name": "@vivliostyle/theme-split-body-recommendation-box",
  "version": "0.0.0",
  "description": "One-page theme for the inner pages of guidelines, with text and footnotes on the left and tables and recommendation boxes on the right",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-split-body-recommendation-box"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Split Body Recommendation Box",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "guideline",
        "a4",
        "two-column",
        "formal",
        "serif",
        "technical"
      ],
      "i18n": {
        "ja": {
          "description": "1ページ完結のガイドライン中間ページ向けテーマ。左に本文と脚注、右に表と推奨ボックスを配置して情報階層を組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Split Body Recommendation Box sample",
        "source": "./templates/default"
      }
    }
  }
}
