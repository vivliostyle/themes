{
  "name": "@vivliostyle/theme-wide-margin-ruleless-list",
  "version": "0.0.0",
  "description": "A5判・1段組のスペシャルティコーヒー店メニューテーマ。広い余白と罫線のない価格表でホワイトスペースを活かした洗練された世界観を表現する",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-wide-margin-ruleless-list"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Wide Margin Ruleless List",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "menu-food",
        "cafe",
        "minimalist",
        "sans-serif",
        "a5",
        "white-space",
        "contemporary",
        "light"
      ]
    },
    "template": {
      "default": {
        "name": "Wide Margin Ruleless List sample",
        "source": "./templates/default"
      }
    }
  }
}
