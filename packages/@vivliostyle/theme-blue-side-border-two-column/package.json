{
  "name": "@vivliostyle/theme-blue-side-border-two-column",
  "version": "0.0.0",
  "description": "Two-column A4 theme for charts of accounts in blue-form tax returns, grouping assets, liabilities, equity, revenue and expenses under blue side-border headings",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-blue-side-border-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Blue Side Border Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "forms",
        "business",
        "chart-of-accounts",
        "a4",
        "two-column",
        "japan",
        "serif"
      ],
      "i18n": {
        "ja": {
          "description": "A4縦2段組の青色申告用勘定科目一覧表テーマ。資産・負債・純資産・収益・費用の五部を青い side-border 見出しでブロック化する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Blue Side Border Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
