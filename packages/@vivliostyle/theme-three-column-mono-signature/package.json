{
  "name": "@vivliostyle/theme-three-column-mono-signature",
  "version": "0.0.0",
  "description": "Three-column theme for API references, with monospaced signatures, argument tables and tinted code examples as one entry, and vertical chapter heads on the fore edge",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-three-column-mono-signature"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Three Column Mono Signature",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "technical",
        "three-column",
        "dense",
        "code-heavy",
        "traditional",
        "dictionary-layout"
      ],
      "i18n": {
        "ja": {
          "description": "3段組のAPIリファレンステーマ。等幅シグネチャ・引数表・淡色地コード例を1エントリとし、小口に縦書きの章柱を置く"
        }
      }
    },
    "template": {
      "default": {
        "name": "Three Column Mono Signature sample",
        "source": "./templates/default"
      }
    }
  }
}
