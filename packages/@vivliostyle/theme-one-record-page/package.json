{
  "name": "@vivliostyle/theme-one-record-page",
  "version": "0.0.0",
  "description": "Single-column theme for architecture decision records, with one record per page and supplementary notes under hairline rules",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-one-record-page"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "One Record Page",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "technical",
        "architecture-decision",
        "shinsho",
        "minimal",
        "serif",
        "elegant",
        "traditional"
      ],
      "i18n": {
        "ja": {
          "description": "1段組のアーキテクチャ決定記録(ADR)テーマ。1レコード1ページ完結で細罫の補足ノートを添える"
        }
      }
    },
    "template": {
      "default": {
        "name": "One Record Page sample",
        "source": "./templates/default"
      }
    }
  }
}
