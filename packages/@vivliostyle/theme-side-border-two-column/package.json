{
  "name": "@vivliostyle/theme-side-border-two-column",
  "version": "0.0.0",
  "description": "Two-column theme for reference tables, grouping three-column ruled tables under side-border headings",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-side-border-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Side Border Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "forms",
        "business",
        "reference",
        "a4",
        "two-column",
        "japanese",
        "serif"
      ],
      "i18n": {
        "ja": {
          "description": "2段組の一覧表テーマ。3列の罫線表を side-border 見出しの部ごとにブロック化する"
        }
      }
    },
    "template": {
      "default": {
        "name": "Side Border Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
