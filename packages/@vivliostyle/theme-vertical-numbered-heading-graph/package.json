{
  "name": "@vivliostyle/theme-vertical-numbered-heading-graph",
  "version": "0.0.0",
  "description": "新書判・縦組み1段の学術新書テーマ。番号付き節見出しと版面下部の横組みグラフを組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-numbered-heading-graph"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Numbered Heading Graph",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "novel",
      "topics": [
        "bunko-shinsho",
        "shinsho",
        "academic",
        "scholarly",
        "vertical-writing",
        "figures",
        "mincho",
        "intellectual"
      ]
    },
    "template": {
      "default": {
        "name": "Vertical Numbered Heading Graph sample",
        "source": "./templates/default"
      }
    }
  }
}
