{
  "name": "@vivliostyle/theme-jupyter-cell-layout",
  "version": "0.0.0",
  "description": "B5判・横組みの機械学習実験ノートブックテーマ。Jupyter Notebook のセル構造を模したコード・出力・数式セルを組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-jupyter-cell-layout"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Jupyter Cell Layout",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "techbook",
        "machine-learning",
        "notebook-style",
        "jupyter-format",
        "b5",
        "code-embedded",
        "research"
      ]
    },
    "template": {
      "default": {
        "name": "Jupyter Cell Layout sample",
        "source": "./templates/default"
      }
    }
  }
}
