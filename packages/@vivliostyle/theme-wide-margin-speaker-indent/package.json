{
  "name": "@vivliostyle/theme-wide-margin-speaker-indent",
  "version": "0.0.0",
  "description": "A4縦・広めの余白を取った1段組の技術同人誌テーマ。対談形式のページを話者名のぶら下げインデントで組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-wide-margin-speaker-indent"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Wide Margin Speaker Indent",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "tech-doujin",
        "dialogue",
        "interview",
        "a4",
        "conversation",
        "wide-margins",
        "easy-read"
      ]
    },
    "template": {
      "default": {
        "name": "Wide Margin Speaker Indent sample",
        "source": "./templates/default"
      }
    }
  }
}
