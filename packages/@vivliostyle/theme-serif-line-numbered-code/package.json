{
  "name": "@vivliostyle/theme-serif-line-numbered-code",
  "version": "0.0.0",
  "description": "A4判1段組のプログラミング言語学術誌テーマ。セリフ本文と左揃え見出し、行番号付きコードブロック、水平罫のみの表で論証を組む",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-serif-line-numbered-code"
  },
  "files": [
    "*.css",
    "example",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Serif Line Numbered Code",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "journal",
      "topics": [
        "academic-journal",
        "academic",
        "a4",
        "single-column",
        "programming",
        "serif",
        "code-heavy",
        "numbered-refs"
      ]
    }
  }
}
