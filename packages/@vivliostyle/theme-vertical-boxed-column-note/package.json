{
  "name": "@vivliostyle/theme-vertical-boxed-column-note",
  "version": "0.0.0",
  "description": "Single-column vertical Shinsho theme for general nonfiction, combining boxed column strips, figures by the gutter and vertical footnotes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-boxed-column-note"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Boxed Column Note",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "novel",
      "topics": [
        "bunko-shinsho",
        "shinsho",
        "cultural",
        "education",
        "vertical-writing",
        "mincho",
        "columns",
        "elegant"
      ],
      "i18n": {
        "ja": {
          "description": "新書判・縦組み1段の教養新書テーマ。罫囲みコラムの縦帯・ノド側の図版・縦組み脚注を組み合わせる"
        }
      }
    },
    "template": {
      "default": {
        "name": "Vertical Boxed Column Note sample",
        "source": "./templates/default"
      }
    }
  }
}
