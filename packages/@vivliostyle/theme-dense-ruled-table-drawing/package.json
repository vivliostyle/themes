{
  "name": "@vivliostyle/theme-dense-ruled-table-drawing",
  "version": "0.0.0",
  "description": "A6縦・モノクロ1段組のボタン型リチウム電池データシートテーマ。高密度な罫線表と外形寸法図をポケットサイズにまとめる",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-dense-ruled-table-drawing"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Dense Ruled Table Drawing",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "datasheet",
        "battery",
        "a6",
        "single-column",
        "compact",
        "technical",
        "minimal"
      ]
    },
    "template": {
      "default": {
        "name": "Dense Ruled Table Drawing sample",
        "source": "./templates/default"
      }
    }
  }
}
