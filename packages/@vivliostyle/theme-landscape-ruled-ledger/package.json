{
  "name": "@vivliostyle/theme-landscape-ruled-ledger",
  "version": "0.0.0",
  "description": "B5判横書きの現金出納帳テーマ。日付・摘要・収入・支出・残高の全幅罫組み表を3階調の罫で構成する",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-landscape-ruled-ledger"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Landscape Ruled Ledger",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": [
        "invoice-forms",
        "ledger",
        "cash",
        "daily",
        "b5",
        "accounting",
        "horizontal",
        "table"
      ]
    },
    "template": {
      "default": {
        "name": "Landscape Ruled Ledger sample",
        "source": "./templates/default"
      }
    }
  }
}
