{
  "name": "@vivliostyle/theme-monospace-band-warning-box",
  "version": "0.0.0",
  "description": "Monospaced theme for API specifications in technical doujinshi, with hairline-grid parameter tables and banded warning boxes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-monospace-band-warning-box"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Monospace Band Warning Box",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "technical",
        "code-focused",
        "monospace",
        "a5",
        "dense"
      ],
      "i18n": {
        "ja": {
          "description": "全編モノスペース組みの技術同人誌 API 仕様書テーマ。細罫グリッドのパラメータ表と帯付き警告ボックスを持つ"
        }
      }
    },
    "template": {
      "default": {
        "name": "Monospace Band Warning Box sample",
        "source": "./templates/default"
      }
    }
  }
}
