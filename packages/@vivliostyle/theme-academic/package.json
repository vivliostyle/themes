{
  "name": "@vivliostyle/theme-academic",
  "version": "3.0.0",
  "description": "Theme for academic papers and reports",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-academic"
  },
  "files": [
    "*.css",
    "example",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Academic",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "category": "journal",
      "style": "theme.css",
      "topics": [
        "academic",
        "report",
        "horizontal-writing",
        "mincho"
      ],
      "i18n": {
        "ja": {
          "description": "学術論文やレポート用のテーマ"
        }
      }
    }
  }
}
