{
  "name": "@vivliostyle/theme-blue-number-badge-two-column",
  "version": "0.0.0",
  "description": "Two-column B5 theme for annual reports of school clubs, with numbered badge headings, boxed articles and tables in a school blue accent",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-blue-number-badge-two-column"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Blue Number Badge Two Column",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "report",
      "topics": [
        "yearbook-anthology",
        "report",
        "b5",
        "two-column",
        "photo-centric",
        "colorful",
        "numbered",
        "youthful"
      ],
      "i18n": {
        "ja": {
          "description": "B5判縦・横組2段の部活動年間活動報告書テーマ。学園ブルーのアクセントで数字バッジ見出し・囲み記事・表を組む"
        }
      }
    },
    "template": {
      "default": {
        "name": "Blue Number Badge Two Column sample",
        "source": "./templates/default"
      }
    }
  }
}
