{
  "name": "@vivliostyle/theme-vertical-matrix-diagram",
  "version": "0.0.0",
  "description": "Single-column vertical theme, flowing horizontal matrix diagrams and data tables at the bottom of the page",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-vertical-matrix-diagram"
  },
  "files": [
    "*.css",
    "templates",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "dependencies": {
    "@vivliostyle/theme-base": "workspace:*"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vertical Matrix Diagram",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "novel",
      "topics": [
        "bunko-shinsho",
        "shinsho",
        "vertical-writing",
        "sans-serif",
        "dense",
        "data-driven"
      ],
      "i18n": {
        "ja": {
          "description": "縦組み1段のテーマ。横組みのマトリクス図とデータ表を紙面下部に回り込ませる"
        }
      }
    },
    "template": {
      "default": {
        "name": "Vertical Matrix Diagram sample",
        "source": "./templates/default"
      }
    }
  }
}
