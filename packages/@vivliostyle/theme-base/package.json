{
  "name": "@vivliostyle/theme-base",
  "version": "3.0.0",
  "description": "Base theme and CSS toolkit for Vivliostyle themes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "(Apache-2.0 AND CC0-1.0 AND MIT)",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-base"
  },
  "files": [
    "theme.css",
    "css",
    "dist",
    "example",
    "vivliostyle.config.js",
    "LICENSES",
    "REUSE.toml"
  ],
  "type": "module",
  "main": "theme.css",
  "exports": {
    ".": "./theme.css",
    "./package.json": "./package.json",
    "./css-variables.json": "./dist/css-variables.json",
    "./appendix": "./css/appendix/index.css",
    "./citation": "./css/citation/index.css",
    "./endnote": "./css/endnote/index.css",
    "./equation": "./css/equation/index.css",
    "./figure": "./css/figure/index.css",
    "./footnote": "./css/footnote/index.css",
    "./listing": "./css/listing/index.css",
    "./math": "./css/math/index.css",
    "./page": "./css/page/index.css",
    "./prism": "./css/prism/index.css",
    "./section": "./css/section/index.css",
    "./sidenote": "./css/sidenote/index.css",
    "./table": "./css/table/index.css",
    "./theorem": "./css/theorem/index.css",
    "./toc": "./css/toc/index.css",
    "./*": "./css/*.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "postcss \"src/**/*.css\" --base src --dir css --no-map",
    "dev": "postcss \"src/**/*.css\" --base src --dir css --no-map -w",
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle theme validate"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "css-tree": "3.2.1",
    "postcss": "8.5.25",
    "postcss-cli": "11.0.1",
    "postcss-value-parser": "4.2.0",
    "postcss-variable-theming": "0.5.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11.3.1"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vivliostyle Base Theme",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme.css",
      "category": "misc",
      "topics": []
    }
  }
}
