{
  "name": "@vivliostyle/theme-base",
  "version": "2.1.1",
  "description": "Base theme and CSS toolkit for Vivliostyle themes",
  "keywords": [
    "vivliostyle",
    "vivliostyle-theme"
  ],
  "homepage": "https://github.com/vivliostyle/themes",
  "license": "CC0-1.0",
  "author": "Vivliostyle <mail@vivliostyle.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivliostyle/themes.git",
    "directory": "packages/@vivliostyle/theme-base"
  },
  "files": [
    "*.css",
    "css",
    "example",
    "vivliostyle.config.js"
  ],
  "type": "module",
  "main": "theme-all.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "postcss src/**/*.css --base src --dir css --no-map",
    "watch": "postcss src/**/*.css --base src --dir css --no-map -w",
    "example:build": "vivliostyle build",
    "example:preview": "vivliostyle preview",
    "validate": "vivliostyle-theme-scripts validate"
  },
  "devDependencies": {
    "postcss": "8.5.25",
    "postcss-cli": "11.0.1",
    "postcss-variable-theming": "^0.3.0"
  },
  "peerDependencies": {
    "@vivliostyle/cli": ">=11"
  },
  "peerDependenciesMeta": {
    "@vivliostyle/cli": {
      "optional": true
    }
  },
  "vivliostyle": {
    "theme": {
      "name": "Vivliostyle Base Theme",
      "author": "Vivliostyle <mail@vivliostyle.org>",
      "style": "theme-all.css",
      "category": "misc",
      "topics": []
    }
  }
}
