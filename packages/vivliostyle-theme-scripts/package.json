    "resolve-pkg": "^2.0.0",
    "serve-handler": "^6.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/serve-handler": "^6.1.0",
    "nodemon": "^3.1.10",
    "shx": "^0.3.2",
    "typescript": "^5.3.3",
    "vitest": "4.1.10"
  }
